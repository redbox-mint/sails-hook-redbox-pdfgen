{
  "name": "@researchdatabox/sails-hook-redbox-pdfgen",
  "version": "1.0.0",
  "description": "ReDBox hook for PDF generation using Puppeteer",
  "main": "dist/index.js",
  "sails": {
    "isHook": true,
    "hasServices": true,
    "hasConfig": true
  },
  "scripts": {
    "compile": "node ./node_modules/@researchdatabox/redbox-dev-tools/bin/run-hook-tsc.js -p tsconfig.json",
    "test": "npm run test:unit && npm run test:integration:mocha",
    "test:unit": "TS_NODE_PROJECT=./test/tsconfig.json npm run compile && node ./node_modules/@researchdatabox/redbox-dev-tools/bin/run-hook-mocha.js --config ./test/unit/.mocharc.cjs ./test/unit",
    "test:integration:mocha": "npm run compile &&docker compose -f ./support/integration-testing/docker-compose.mocha.yml up --build --menu=false --abort-on-container-exit --exit-code-from redboxportal",
    "test:integration:mocha:clean": "docker compose -f ./support/integration-testing/docker-compose.mocha.yml down -v --remove-orphans --timeout 180",
    "test:integration:bruno": "npm run compile && docker compose -f ./support/api-integration-testing/docker-compose.bruno.yml up --build --menu=false --abort-on-container-exit --exit-code-from bruno",
    "test:integration:bruno:clean": "docker compose -f ./support/api-integration-testing/docker-compose.bruno.yml down -v --remove-orphans --timeout 180",
    "dev:run": "docker compose -f ./support/development/docker-compose.yml up --build --menu=false --abort-on-container-exit --exit-code-from rbportal",
    "dev:run:build": "docker compose -f ./support/development/docker-compose.yml build",
    "dev:run:clean": "docker compose -f ./support/development/docker-compose.yml down -v --remove-orphans --timeout 180",
    "dev:run:prepare": "mkdir -p ./support/development/.tmp/attachments/staging"
  },
  "keywords": [
    "sails",
    "hook",
    "redbox"
  ],
  "license": "GPL-3.0",
  "dependencies": {
    "puppeteer": "24.39.1"
  },
  "peerDependencies": {
    "@researchdatabox/redbox-core-types": "0.0.1-beta.9022"
  },
  "devDependencies": {
    "@researchdatabox/redbox-core-types": "0.0.1-beta.9022",
    "@researchdatabox/redbox-dev-tools": "0.0.1-beta.9020",
    "@types/node": "24.12.2"
  }
}
