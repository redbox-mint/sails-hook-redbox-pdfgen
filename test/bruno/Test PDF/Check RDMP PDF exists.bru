meta {
  name: Check RDMP PDF exists
  type: http
  seq: 2
}

get {
  url: {{host}}/default/rdmp/record/{{dmpOid}}/attachments
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
  x-source: jsclient
}

script:pre-request {
  await new Promise((resolve) => setTimeout(() => resolve(), 20000));
}

tests {
// NOTE: api endpoint doesn't provide access to the generated pdfs: '{{host}}/default/rdmp/api/records/datastreams/{{dmpOid}}'
  const _ = require('lodash');
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });

  test("Has attachments", function () {
      var jsonData = res.body;

      console.log(jsonData);

      // should be one attachment, with pdf ext
      expect(_.size(jsonData)).to.equal(1);

      // stored in Gridfs
      expect(jsonData[0].redboxOid).to.equal(bru.getEnvVar("dmpOid"));
      bru.setEnvVar("recordStreamId",jsonData[0].fileId);

      expect(_.endsWith(jsonData[0].fileId, '.pdf')).to.equal(true);
  });
}
