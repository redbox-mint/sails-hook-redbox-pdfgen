{
    "compilerOptions": {
        "skipLibCheck": true,
        "target": "es2020",
        "module": "commonjs",
        "moduleResolution": "node",
        "isolatedModules": false,
        "strict": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "declaration": false,
        "noImplicitAny": false,
        "noImplicitUseStrict": false,
        "removeComments": true,
        "noLib": false,
        "preserveConstEnums": true,
        "sourceMap": false,
        "inlineSourceMap": true,
        "outDir": "./dist",
        "rootDir": "./src"
    },
    "exclude": [
        "node_modules/**",
        "typings/**",
        "assets/angular/**",
        "angular/**"
    ],
    "include": [
        "src/**/*.ts"
    ],
    "compileOnSave": true,
    "buildOnSave": false,
    "atom": {
        "rewriteTsconfig": false
    }
}
